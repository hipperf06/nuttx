config GD32H7_SERIALDRIVER
	bool
	default n

endmenu # U[S]ART Configuration

menu "GD32H7 Peripheral Support"
	depends on ARCH_CHIP_GD32H7

config GD32H7_DMA
	bool
	default n

config GD32H7_DMA0
	bool "DMA0"
	default n
	select GD32H7_DMA
	select ARCH_DMA

config GD32H7_DMA1
	bool "DMA1"
	default n
	select GD32H7_DMA
	select ARCH_DMA

config GD32H7_SPI
	bool
	default n

config GD32H7_SPI0
	bool "SPI0"
	default n
	select SPI
	select GD32H7_SPI

config GD32H7_SPI1
	bool "SPI1"
	default n
	select SPI
	select GD32H7_SPI

config GD32H7_SPI2
	bool "SPI2"
	default n
	select SPI
	select GD32H7_SPI

config GD32H7_SPI3
	bool "SPI3"
	default n
	select SPI
	select GD32H7_SPI

config GD32H7_SPI4
	bool "SPI4"
	default n
	select SPI
	select GD32H7_SPI

config GD32H7_SPI5
	bool "SPI5"
	default n
	select SPI
	select GD32H7_SPI

config GD32H7_I2C
	bool
	default n

config GD32H7_I2C0
	bool "I2C0"
	default n
	select I2C
	select GD32H7_I2C

config GD32H7_I2C1
	bool "I2C1"
	default n
	select I2C
	select GD32H7_I2C

config GD32H7_I2C2
	bool "I2C2"
	default n
	select I2C
	select GD32H7_I2C

config GD32H7_I2C3
	bool "I2C3"
	default n
	select I2C
	select GD32H7_I2C

config GD32H7_TIMER
	bool
	default n

config GD32H7_PWM
	bool "PWM support"
	default n
	depends on PWM
	select GD32H7_TIMER

config GD32H7_FWDGT
	bool "Free watchdog timer (FWDGT)"
	default n
	select WATCHDOG

config GD32H7_CRC
	bool "CRC accelerator"
	default n

config GD32H7_TRNG
	bool "True random number generator (TRNG)"
	default n

config GD32H7_PMU
	bool "Power management unit (PMU)"
	default n

config GD32H7_ADC
	bool
	default n

config GD32H7_ADC0
	bool "ADC0"
	default n
	select GD32H7_ADC

config GD32H7_ADC1
	bool "ADC1"
	default n
	select GD32H7_ADC

config GD32H7_ADC2
	bool "ADC2"
	default n
	select GD32H7_ADC

config GD32H7_DAC
	bool "DAC support"
	default n

config GD32H7_RTC
	bool "Real-time clock (RTC)"
	default n
	select RTC
	select RTC_DATETIME

config GD32H7_CAN
	bool
	default n

config GD32H7_CAN0
	bool "CAN0"
	default n
	depends on CAN
	select GD32H7_CAN

config GD32H7_CAN1
	bool "CAN1"
	default n
	depends on CAN
	select GD32H7_CAN

config GD32H7_CAN2
	bool "CAN2"
	default n
	depends on CAN
	select GD32H7_CAN

config GD32H7_FMC
	bool "Flash memory controller (progmem API)"
	default n

config GD32H7_SDIO
	bool "SDIO support (polling mode)"
	default n
	depends on MMCSD
	select ARCH_HAVE_SDIO

endmenu # GD32H7 Peripheral Support

menu "Memory Configuration"
	depends on ARCH_CHIP_GD32H7

config GD32H7_DTCMHEAP
	bool "Add DTCM to the heap"
	default n
	---help---
		Add the 64KiB DTCM as a second heap region.  DTCM is not usable
		for DMA; when CONFIG_ARCH_DMA is enabled this option must not
		be selected.

if GD32H7_DTCMHEAP

config MM_REGIONS
	int "Number of memory regions"
	default 2
	range 2 2

endif # GD32H7_DTCMHEAP

config GD32H7_DTCMEXCLUDE
	bool
	default n

endmenu # Memory Configuration

# endif # ARCH_CHIP_GD32H7
