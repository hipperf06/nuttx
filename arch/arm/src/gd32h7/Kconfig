# if ARCH_CHIP_GD32H7

comment "GD32H7 Configuration Options"

choice
	prompt "GD32H7 Chip Selection"
	default ARCH_CHIP_GD32H757
	depends on ARCH_CHIP_GD32H7

config ARCH_CHIP_GD32H737
	bool "GD32H737"
	select GD32H7_GD32H73x
	select GD32H7_FLASH_1M
	---help---
		GD32 H7 Cortex M7, 600MHz, 1024 KiB FLASH, 1024 KiB SRAM

config ARCH_CHIP_GD32H757
	bool "GD32H757"
	select GD32H7_GD32H73x
	select GD32H7_FLASH_2M
	---help---
		GD32 H7 Cortex M7, 600MHz, 2048 KiB FLASH, 1024 KiB SRAM

endchoice # GD32H7 Chip Selection

config GD32H7_GD32H73x
	bool
	default n
	---help---
		GD32H73x series (GD32H737, GD32H757)

config GD32H7_FLASH_1M
	bool
	default n

config GD32H7_FLASH_2M
	bool
	default n

menu "Clock Configuration"
	depends on ARCH_CHIP_GD32H7

choice
	prompt "System clock source"
	default GD32H7_PLL_HXTAL
	depends on ARCH_CHIP_GD32H7

config GD32H7_USE_IRC64M
	bool "IRC64M (64MHz, no PLL)"
	---help---
		Run the system clock from the internal 64MHz RC oscillator.
		The PLL is not used.

config GD32H7_PLL_HXTAL
	bool "PLL0 fed by HXTAL"
	---help---
		Run the system clock from PLL0 which is fed by the external
		high speed crystal oscillator.  The PLL configuration must be
		provided in board.h via GD32_PLL0PSC/N/P/Q/R.

endchoice # System clock source

endmenu # Clock Configuration

menu "U[S]ART Configuration"
	depends on ARCH_CHIP_GD32H7

# The per-UART options USARTn_BAUD/BITS/PARITY/2STOP/RXBUFSIZE/TXBUFSIZE and
# USARTn_SERIAL_CONSOLE are provided by the generic drivers/serial Kconfig
# files; they become visible once USARTn_SERIALDRIVER is selected below.

config GD32H7_USART0
	bool "USART0"
	---help---
		Enable USART0

if GD32H7_USART0

choice
	prompt "USART0 Driver Configuration"
	default GD32H7_USART0_SERIALDRIVER

config GD32H7_USART0_SERIALDRIVER
	bool "Standard serial driver"
	select USART0_SERIALDRIVER
	select ARCH_HAVE_SERIAL_TERMIOS
	select GD32H7_SERIALDRIVER

endchoice # USART0 Driver Configuration

endif # GD32H7_USART0

config GD32H7_USART1
	bool "USART1"
	---help---
		Enable USART1

if GD32H7_USART1

choice
	prompt "USART1 Driver Configuration"
	default GD32H7_USART1_SERIALDRIVER

config GD32H7_USART1_SERIALDRIVER
	bool "Standard serial driver"
	select USART1_SERIALDRIVER
	select ARCH_HAVE_SERIAL_TERMIOS
	select GD32H7_SERIALDRIVER

endchoice # USART1 Driver Configuration

endif # GD32H7_USART1

config GD32H7_USART2
	bool "USART2"
	---help---
		Enable USART2

if GD32H7_USART2

